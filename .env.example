# Configuração do Banco de Dados (Backend)
# Para execução local rápida (padrão): sqlite:///./triagem.db
# Para PostgreSQL (Docker / Produção):
DATABASE_URL=postgresql://triagem_user:triagem_pass@localhost:5432/triagem_db

# URL da API consumida pelo Next.js (Frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
